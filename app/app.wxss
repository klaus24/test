page {
  background: #0f1115;
  color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container {
  padding: 24rpx;
}

.card {
  background: #1c1f26;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.3);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.field {
  margin-bottom: 16rpx;
}

.label {
  font-size: 24rpx;
  color: #9aa1b2;
  margin-bottom: 8rpx;
}

.input {
  background: #13161c;
  border: 1px solid #2a2f3a;
  border-radius: 12rpx;
  padding: 16rpx;
  color: #f5f5f5;
}

.primary-btn {
  background: linear-gradient(135deg, #4c6ef5, #7a5af8);
  color: #fff;
  border-radius: 999rpx;
  padding: 18rpx 0;
  font-size: 28rpx;
  font-weight: 600;
}

.secondary-btn {
  background: #222631;
  color: #d5d9e0;
  border-radius: 999rpx;
  padding: 14rpx 0;
  font-size: 26rpx;
}

.flex-row {
  display: flex;
  gap: 16rpx;
}

.flex-row .button {
  flex: 1;
}

.map-wrap {
  border-radius: 16rpx;
  overflow: hidden;
  border: 1px solid #2a2f3a;
}

.map-info {
  font-size: 22rpx;
  color: #9aa1b2;
  margin-top: 8rpx;
}

.poster-preview {
  width: 100%;
  border-radius: 16rpx;
}
